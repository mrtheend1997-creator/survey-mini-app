# ---- Copy this file to .env and fill in the values ----

# Telegram bot token from @BotFather. Stays on the server, never reaches the browser.
BOT_TOKEN=1234567890:AAAA-your-bot-token

# Public HTTPS address of the Mini App (your domain).
WEBAPP_URL=https://survey.example.uz
# Domain for automatic HTTPS (usually the same domain without https://). Use :80 for a local test.
SITE_ADDRESS=survey.example.uz

# Telegram ID(s) of the first Super Admin(s), comma separated. Find yours via @userinfobot.
SUPER_ADMIN_TELEGRAM_IDS=123456789

# Database
POSTGRES_DB=fti_survey
POSTGRES_USER=fti
POSTGRES_PASSWORD=change-me-to-a-long-random-password

# Optional
APP_TIMEZONE=Asia/Tashkent
INIT_DATA_MAX_AGE=86400
BACKUP_KEEP_DAYS=14
